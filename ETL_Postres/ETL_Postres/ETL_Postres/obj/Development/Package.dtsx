                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT v.Fecha, v.IDUsuario, v.IDMesa, v.IDMetodoPago, v.IDTipoDocumento,
       v.IDVenta, dv.IDDetalleVenta, dv.IDProducto, dv.Cantidad, dv.PrecioUnitario, dv.Subtotal
FROM PostresDB.dbo.DetalleVenta dv
JOIN PostresDB.dbo.Venta v ON v.IDVenta = dv.IDVenta
WHERE v.Estado = 1 AND dv.Estado = 1;</property>
