                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT IDMetodoPago, NombreMetodo AS MetodoPago,
       CASE WHEN NombreMetodo = N'Efectivo' THEN N'Efectivo'
            WHEN NombreMetodo = N'Tarjeta' THEN N'Tarjeta'
            WHEN NombreMetodo IN (N'Yape', N'Plin') THEN N'Billetera digital'
            ELSE N'Otros' END AS TipoPago
FROM dbo.MetodoPago;</property>
