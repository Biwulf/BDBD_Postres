                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT u.IDUsuario, u.Usuario, u.Nombre, u.Apellido,
       CONCAT(u.Nombre, N' ', u.Apellido) AS NombreCompleto,
       r.NombreRol AS Rol, u.Telefono,
       CASE WHEN u.Estado = 1 THEN N'Activo' ELSE N'Inactivo' END AS Estado
FROM dbo.Usuarios u
JOIN dbo.Roles r ON r.IDRol = u.IDRol;</property>
