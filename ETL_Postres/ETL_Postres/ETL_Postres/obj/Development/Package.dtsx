                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT p.IDProductos AS IDProducto,
       p.Nombre AS Producto,
       CAST(LEFT(p.Descripcion, 200) AS NVARCHAR(200)) AS Descripcion,
       c.NombreCategoria AS Categoria,
       p.PrecioCompra,
       p.PrecioVenta,
       CAST(p.PrecioVenta - p.PrecioCompra AS DECIMAL(10,2)) AS MargenUnitario,
       p.StockMinimo,
       CAST(CASE WHEN p.Estado = 1 THEN N'Activo' ELSE N'Inactivo' END AS NVARCHAR(10)) AS Estado
FROM dbo.Productos p
JOIN dbo.Categoria c ON c.IDCategoria = p.IDCategoria;</property>
