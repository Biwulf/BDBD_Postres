    <DTS:Executable
      DTS:refId="Package\Tarea Ejecutar SQL"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Tarea Ejecutar SQL"
      DTS:DTSID="{1A49257B-39D3-442C-B37F-C7CB015CE58F}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Tarea Ejecutar SQL"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{4E64E099-66A7-430C-8AC9-B0E101391795}"
          SQLTask:SqlStatementSource="&#xA;&#xA;TRUNCATE TABLE dbo.FactVentas;&#xA;TRUNCATE TABLE dbo.FactCompras;&#xA;DELETE FROM dbo.DimProducto;      DBCC CHECKIDENT ('dbo.DimProducto', RESEED, 0);&#xA;DELETE FROM dbo.DimEmpleado;      DBCC CHECKIDENT ('dbo.DimEmpleado', RESEED, 0);&#xA;DELETE FROM dbo.DimMetodoPago;    DBCC CHECKIDENT ('dbo.DimMetodoPago', RESEED, 0);&#xA;DELETE FROM dbo.DimProveedor;     DBCC CHECKIDENT ('dbo.DimProveedor', RESEED, 0);&#xA;DELETE FROM dbo.DimMesa;          DBCC CHECKIDENT ('dbo.DimMesa', RESEED, 0);&#xA;DELETE FROM dbo.DimTipoDocumento; DBCC CHECKIDENT ('dbo.DimTipoDocumento', RESEED, 0);&#xA;&#xA;INSERT INTO dbo.DimMesa (IDMesa, Mesa)&#xA;SELECT IDMesa, CONCAT(N'Mesa ', IDMesa) FROM PostresDB.dbo.Mesas;&#xA;&#xA;INSERT INTO dbo.DimTipoDocumento (IDTipoDocumento, TipoDocumento)&#xA;SELECT IDTipoDocumento, NombreDocumento FROM PostresDB.dbo.TipoDocumento;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Tarea Ejecutar SQL 1"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Tarea Ejecutar SQL"
      DTS:DTSID="{3AD2E6E0-E069-4D6D-8237-DB6C913C84F8}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Tarea Ejecutar SQL 1"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{4E64E099-66A7-430C-8AC9-B0E101391795}"
          SQLTask:SqlStatementSource="SELECT COALESCE(MAX(dt.Fecha), '2010-01-01')&#xA;FROM PostresDM.dbo.DimTiempo dt&#xA;INNER JOIN PostresDM.dbo.FactVentas fs ON dt.FechaKey = fs.FechaKey;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
